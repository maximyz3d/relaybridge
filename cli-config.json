  "gemini": {
    "label": "Gemini (Antigravity)",
    "company": "Google",
    "transport": "subscription:antigravity",
    "color": "#4285f4",
    "safe": [
      "agy.exe",
      "--model",
      "gemini-3.1-pro-high",
      "--mode",
      "plan",
      "--sandbox"
    ],
    "dangerous": [
      "agy.exe",
      "--model",
      "gemini-3.1-pro-high",
      "--mode",
      "accept-edits",
      "--dangerously-skip-permissions"
    ],
    "oneshot_safe": [
      "agy.exe",
      "--model",
      "gemini-3.1-pro-high",
      "--mode",
      "plan",
      "--print-timeout",
      "3m",
      "--disable-slash-commands",
      "--sandbox",
      "--print",
      "{prompt}"
    ],
    "oneshot_dangerous": [
      "agy.exe",
      "--model",
      "gemini-3.1-pro-high",
      "--mode",
      "accept-edits",
      "--print-timeout",
      "3m",
      "--disable-slash-commands",
      "--dangerously-skip-permissions",
      "--print",
      "{prompt}"
    ],
    "prompt_max_chars": 24000,
    "probe": [
      "agy.exe",
      "models"
    ],
    "probe_expect": "gemini-3.1-pro-high",
    "probe_success_detail": "authenticated; configured Gemini model is available",
    "version_probe": [
      "agy.exe",
      "--version"
    ],
    "strip_env": [
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "GOOGLE_GENAI_USE_VERTEXAI"
    ],
    "install_command": [
      "powershell.exe",
      "-NoLogo",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "irm https://antigravity.google/cli/install.ps1 | iex"
    ],
    "install_display": "irm https://antigravity.google/cli/install.ps1 | iex",
    "post_install": "Open a fresh PowerShell and run agy once to sign in.",
    "docs_url": "https://antigravity.google/docs/cli/gcli-migration"
  },
