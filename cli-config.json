  "perplexity": {
    "label": "Perplexity",
    "company": "Perplexity",
    "transport": "subscription:pwm",
    "model": "auto",
    "color": "#20b8cd",
    "safe": [
      "node",
      "tools/pplx.js"
    ],
    "dangerous": [
      "node",
