{
  "_comment": "Per-CLI config. 'safe'/'dangerous' launch interactive sessions. 'oneshot_safe'/'oneshot_dangerous' power Collab Mode. Use {prompt} for a bounded inline prompt, {prompt_file} when the CLI supports a file, or no placeholder to pipe stdin. 'probe' is a non-mutating readiness check. Edit freely.",
  "powershell": {
    "label": "PowerShell",
    "company": "Microsoft",
    "color": "#0078d4",
    "safe": [
      "powershell.exe",
      "-NoLogo"
    ],
    "dangerous": [
      "powershell.exe",
      "-NoLogo",
      "-ExecutionPolicy",
      "Bypass"
    ]
  },
  "claude": {
    "label": "Claude Code",
    "company": "Anthropic",
    "transport": "subscription:anthropic",
    "color": "#cc785c",
    "safe": [
      "claude",
      "--permission-mode",
      "plan",
      "--model",
      "opus",
      "--effort",
      "max"
    ],
    "dangerous": [
      "claude",
      "--model",
      "opus",
      "--effort",
      "max",
      "--dangerously-skip-permissions"
    ],
    "oneshot_safe": [
      "claude",
      "-p",
      "--permission-mode",
      "plan",
      "--model",
      "opus",
      "--effort",
      "max"
    ],
    "oneshot_dangerous": [
      "claude",
      "-p",
      "--model",
      "opus",
      "--effort",
      "max",
      "--dangerously-skip-permissions"
    ],
    "probe": [
      "claude",
      "auth",
      "status"
    ],
    "probe_redact": true,
    "probe_success_detail": "authenticated Claude subscription session",
    "version_probe": [
      "claude",
      "--version"
    ],
    "strip_env": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "ANTHROPIC_BASE_URL",
      "CLAUDE_CODE_USE_BEDROCK",
      "CLAUDE_CODE_USE_VERTEX",
      "CLAUDE_CODE_USE_FOUNDRY"
    ],
    "npm_package": "@anthropic-ai/claude-code"
  },
