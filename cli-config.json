    "label": "PowerShell",
    "company": "Microsoft",
    "color": "#0078d4",
    "safe": [
      "powershell.exe",
      "-NoLogo"
    ],
    "dangerous": [
      "powershell.exe",
      "-NoLogo",
      "-ExecutionPolicy",
      "Bypass"
    ]
  },
